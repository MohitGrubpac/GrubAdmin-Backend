// Hospitality Employee
model vertical_hospitality_employee {
  id                  String                          @id @default(ulid())
  first_name          String
  last_name           String
  country_code        String
  mobile_number       String
  email               String
  password            String?
  employee_display_id String
  joining_date        DateTime                        @default(now())
  client_id           String?
  role                hospitality_employee_role
  status              employee_status                 @default(unassigned)
  profile_pic         String?
  created_at          DateTime                        @default(now())
  updated_at          DateTime                        @updatedAt
  client              client?                         @relation(fields: [client_id], references: [id])
  connected_boxes     box[]                           @relation("hospitality_box_connection")
  employee_boxes      vertical_hospitality_employee_box[] @relation("vertical_hospitality_employee_boxes")

  @@unique([client_id, email])
  @@unique([client_id, employee_display_id])
  @@unique([client_id, country_code, mobile_number])
  @@index([client_id], map: "vertical_hospitality_employee_client_id_idx")
  @@map("vertical_hospitality_employee")
}

// Hospitality Employee-Box Assignment
model vertical_hospitality_employee_box {
  id          String                             @id @default(ulid())
  employee_id String?
  box_id      String
  status      hospitality_employee_box_status    @default(shared)
  access      hospitality_employee_box_access    @default(direct)
  created_at  DateTime                           @default(now())
  updated_at  DateTime                           @updatedAt
  box         box                                @relation("vertical_hospitality_employee_boxes", fields: [box_id], references: [id], onDelete: Cascade)
  employee    vertical_hospitality_employee?     @relation("vertical_hospitality_employee_boxes", fields: [employee_id], references: [id], onDelete: SetNull)

  @@unique([employee_id, box_id])
  @@index([box_id], map: "vertical_hospitality_employee_box_box_id_idx")
  @@index([employee_id], map: "vertical_hospitality_employee_box_employee_id_idx")
  @@map("vertical_hospitality_employee_box")
}

