PORT=8000
NODE_ENV=production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# For Aiven: append ?ssl-mode=REQUIRED to DATABASE_URL.
# For AWS RDS: use the RDS endpoint hostname (*.rds.amazonaws.com).
# MySQL TLS verification — download RDS combined CA bundle from AWS docs:
#   https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL.html
# Pilot P0: install PEM on EC2 (e.g. /etc/ssl/certs/rds-combined-ca-bundle.pem), then set:
# DATABASE_SSL_CA_PATH=/etc/ssl/certs/rds-combined-ca-bundle.pem
# Alias: RDS_CA_BUNDLE_PATH. When path is set and readable, rejectUnauthorized=true.
# Until CA path is set, Aiven/RDS still connect with unverified TLS (rejectUnauthorized=false) + startup warning.
# MySQL pool (single PM2 process serves all verticals). Code default is 10 (local dev only).
# Pilot/production: 15–20; raise if logs show mysql_pool_timeout or Prisma pool exhaustion.
# Legacy alias: MYSQL_POOL_LIMIT. Valid range clamped in code to 1–50.
DATABASE_POOL_SIZE=20

# Grace period for SIGTERM/SIGINT shutdown (HTTP drain + DB disconnect). PM2 kill_timeout should be >= this.
# SHUTDOWN_GRACE_MS=15000

MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/DATABASE?authSource=admin
MAIL=your_email@example.com
MAIL_PASS=your_app_password
AUTH_SECRET=change_me_to_a_random_uuid

SEED_EMAIL=admin@example.com
SEED_PASSWORD=change_me
SEED_NAME=Admin
SEED_LAST_NAME=User
SEED_COUNTRY_CODE=+1
SEED_MOBILE_NUMBER=5550000000

AWS_KEY=your_aws_key
AWS_SECRET=your_aws_secret
AWS_REGION=us-east-1
AWS_BUCKET_NAME=grubpac-admin-s3
# Camp camera uses CAMERA_S3_PREFIX below (not a separate bucket)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCipqtnX7bKPe60ixXtTNOXrutccOCxeMo

# IPs removed from code — set here for production (see also src/configs/env.ts).
# Required in production — hospitality impersonation + password-reset emails (no dev localhost fallback).
FRONTEND_URL=http://13.127.79.155
CLIENT_DASHBOARD_URL=http://13.127.79.155
# Same as CLIENT_DASHBOARD_URL until hospitality FE is deployed on AWS.
HOSPITALITY_FRONTEND_URL=http://13.127.79.155

# Comma-separated CORS origins — production uses ONLY this list (no localhost, no *.vercel.app).
# After P1 DNS, replace placeholders with real admin/delivery/API HTTPS origins.
ALLOWED_ORIGINS=https://admin.example.com,https://delivery.example.com,https://43.204.34.10.nip.io
# Allow http(s)://localhost and 127.0.0.1 for Flutter/web simulators hitting staging API (default off).
# Enable on staging only — leave unset/false on production lockdown.
# CORS_ALLOW_LOCALHOST=true

JWT_ACCESS_TOKEN_EXPIRY=86400
JWT_REFRESH_TOKEN_EXPIRY=604800
HOSPITALITY_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
DELIVERY_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
MEDICAL_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars
CAMPING_AUTH_SECRET=change_me_to_a_random_string_at_least_64_chars

# Mobile app API base URLs (for native app config / deep links — not read by backend code).
# Use the public HTTPS nip.io host that nginx proxies to this API (port 8000 behind nginx :443).
# MEDICAL_MOBILE_API_BASE_URL=https://43.204.34.10.nip.io/api/v1/medical-mobile
# CAMP_CONSUMER_API_BASE_URL=https://43.204.34.10.nip.io/api/v1/camp-consumer
# DELIVERY_MOBILE_API_BASE_URL=https://43.204.34.10.nip.io/api/v1/delivery-mobile

# Camp camera S3 prefix (required for camp camera in prod)
CAMERA_S3_PREFIX=camp-camera
# Optional / unused — native OS share (Option A) does not need a web share page
# MEDICAL_MOBILE_SHARE_BASE_URL=https://share.example.com/medical
# SIMULATOR_DEFAULT_LAT=
# SIMULATOR_DEFAULT_LNG=
