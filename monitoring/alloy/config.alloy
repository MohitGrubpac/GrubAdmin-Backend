local.file_match "pm2_production" {
  path_targets = [
    {
      "__path__"       = "/var/log/pm2/grub-prod-blue-out.log",
      "service"        = "grubadmin-backend",
      "environment"    = "production",
      "deployment_slot" = "blue",
      "log_type"       = "stdout",
      "host"           = "ec2-production",
    },
    {
      "__path__"       = "/var/log/pm2/grub-prod-blue-error.log",
      "service"        = "grubadmin-backend",
      "environment"    = "production",
      "deployment_slot" = "blue",
      "log_type"       = "stderr",
      "host"           = "ec2-production",
    },
    {
      "__path__"       = "/var/log/pm2/grub-prod-green-out.log",
      "service"        = "grubadmin-backend",
      "environment"    = "production",
      "deployment_slot" = "green",
      "log_type"       = "stdout",
      "host"           = "ec2-production",
    },
    {
      "__path__"       = "/var/log/pm2/grub-prod-green-error.log",
      "service"        = "grubadmin-backend",
      "environment"    = "production",
      "deployment_slot" = "green",
      "log_type"       = "stderr",
      "host"           = "ec2-production",
    },
  ]
  sync_period = "10s"
}

loki.source.file "pm2_production" {
  targets       = local.file_match.pm2_production.targets
  forward_to    = [loki.process.pm2_production.receiver]
  tail_from_end = true
}

loki.process "pm2_production" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
